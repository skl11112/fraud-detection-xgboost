      "负债合计": 977009600.0,
      "实收资本_股本_": 2661233000.0,
      "盈余公积": 93161182.2,
      "未分配利润": -4139021000.0,
      "股东权益合计": 266391500.0,
      "营业总收入": 353958000.0,
      "营业成本": 304642400.0,
      "销售费用": 0.0,
      "管理费用": 35739850.0,
      "财务费用": 24590968.0,
      "投资收益": 38192410.0,
      "资产减值损失": 0.0,
      "营业利润": 35445890.0,
      "利润总额": 34860500.0,
      "所得税费用": -53491210.0,
      "净利润": 88351720.0,
      "归属于母公司净利润": 88351720.0,
      "经营活动现金净流量": -41216814.2,
      "支付的所得税": 11115347.57,
      "销售商品收到的现金": 152357100.0,
      "投资活动现金净流量": -74868860.0,
      "筹资活动现金净流量": 31963820.0,
      "审计缺失标志": 0,
      "是否ST": 0,
      "违规状态": 0,
      "是否金融业": 0,
      "审计师通过": 2.396839e-17
    }
  },
  "example_response": {
    "risk_probability": 0.723456,
    "risk_result": "高风险",
    "base_value": -1.2345,
    "shap_explain": [
      {
        "feature_name": "未分配利润",
        "feature_value": -4139021000.0,
        "shap_value": 0.8523,
        "abs_shap_value": 0.8523
      },
      {
        "feature_name": "营业成本",
        "feature_value": 304642400.0,
        "shap_value": 0.4512,
        "abs_shap_value": 0.4512
      }
    ],
    "top_risk_factors": [
      "未分配利润 (SHAP=+0.8523)",
      "营业成本 (SHAP=+0.4512)",
      "财务费用 (SHAP=+0.3201)"
    ],
    "disclaimer": "⚠️ 本模型输出仅为风险预警参考，不能直接定性财务舞弊。"
  }
}
